# Normalize text files in the repository to LF.
* text=auto eol=lf

# Windows command files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep PowerShell scripts as LF unless a specific tool requires CRLF.
*.ps1 text eol=lf

# Explicit binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
